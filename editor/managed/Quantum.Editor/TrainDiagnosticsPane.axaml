<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Quantum.Editor" xmlns:managed="using:Quantum.Managed" x:Class="Quantum.Editor.TrainDiagnosticsPane" x:DataType="local:EditorViewModel">
  <TabControl>
    <TabItem Header="Preview / engineering overlays"><StackPanel Margin="16" Spacing="12">
      <TextBlock Classes="heading" Text="NATIVE VULKAN TRAIN PREVIEW" /><TextBlock Text="{Binding TrainPreviewStatus}" TextWrapping="Wrap" />
      <WrapPanel><Button Content="Frame train" Command="{Binding FrameTrainCommand}" /><Button Content="Selected car / bogies / hitches" Command="{Binding FrameCarCommand}" /><Button Content="Front" Command="{Binding FrameTrainFrontCommand}" /><Button Content="Rear" Command="{Binding FrameTrainRearCommand}" /></WrapPanel>
      <WrapPanel><CheckBox Content="Body/reference bounds" IsChecked="{Binding ShowTrainBounds}" /><CheckBox Content="Bogies" IsChecked="{Binding ShowTrainBogies}" /><CheckBox Content="Hitches / connectors" IsChecked="{Binding ShowTrainHitches}" /><CheckBox Content="Loaded COG" IsChecked="{Binding ShowTrainCog}" /><CheckBox Content="Car reference frame" IsChecked="{Binding ShowTrainFrame}" /></WrapPanel>
      <TextBlock Classes="muted" Text="Selection uses physical reference envelopes in Train mode. Yellow = selected car; magenta = loaded COG; white = bogies; orange = hitches/connectors. Numeric Apply preserves camera orientation. Roles do not lock physics." TextWrapping="Wrap" />
    </StackPanel></TabItem>
    <TabItem Header="Summary / diagnostics"><Grid ColumnDefinitions="340,*,*" Margin="16" ColumnSpacing="20">
      <StackPanel><TextBlock Classes="heading" Text="AUTHORITATIVE NATIVE SUMMARY" /><TextBlock Text="{Binding TrainSummaryDetails}" Classes="technical" TextWrapping="Wrap" Margin="0,10" /><TextBlock Classes="muted" Text="Straight assembly, body-envelope to body-envelope, relative to car 0 body origin. Curved-track poses and world COG come from the solver." TextWrapping="Wrap" /></StackPanel>
      <ScrollViewer Grid.Column="1"><ItemsControl ItemsSource="{Binding TrainCarSummaries}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="managed:TrainCarSummary"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      <ScrollViewer Grid.Column="2"><StackPanel><TextBlock Classes="heading" Text="ERROR / WARNING" /><ItemsControl ItemsSource="{Binding TrainDiagnostics}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="managed:TrainDiagnostic"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,5" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
    </Grid></TabItem>
  </TabControl>
</UserControl>
