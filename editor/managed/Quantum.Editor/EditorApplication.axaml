<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Quantum.Editor.EditorApplication" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Quantum.Editor/Theme/QuantumTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="{StaticResource QuantumAccentColor}"
                               RegionColor="{StaticResource QuantumSurfaceColor}"
                               ListLow="{StaticResource QuantumSurfaceColor}"
                               ListMedium="{StaticResource QuantumSelectionColor}" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Quantum.Editor/Theme/QuantumControls.axaml" />
  </Application.Styles>
</Application>
