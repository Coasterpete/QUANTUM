<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../../assets/icons/quantum/quantum.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Quantum.Managed/Quantum.Managed.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <AvaloniaResource Include="../../assets/fonts/Overpass/overpass-regular.otf" Link="Assets/overpass-regular.otf" />
    <AvaloniaResource Include="../../assets/fonts/Overpass/overpass-semibold.otf" Link="Assets/overpass-semibold.otf" />
    <AvaloniaResource Include="../../assets/fonts/Overpass/overpass-mono-regular.otf" Link="Assets/overpass-mono-regular.otf" />
    <None Include="../../assets/fonts/Overpass/LICENSE.md" Link="licenses/Overpass/LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/fonts/Overpass/README.md" Link="licenses/Overpass/README.md" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="../../../assets/icons/quantum/quantum.ico" Link="Assets/quantum.ico" />
  </ItemGroup>
</Project>
