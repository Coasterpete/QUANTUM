<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../../assets/icons/quantum/quantum.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Quantum.Managed/Quantum.Managed.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <AvaloniaResource Include="../../assets/fonts/Overpass/overpass-regular.otf" Link="Assets/overpass-regular.otf" />
    <AvaloniaResource Include="../../assets/fonts/Red_Hat_Mono/static/RedHatMono-Regular.ttf" Link="Assets/RedHatMono-Regular.ttf" />
    <AvaloniaResource Include="../../../assets/icons/quantum/quantum.ico" Link="Assets/quantum.ico" />
  </ItemGroup>
</Project>
