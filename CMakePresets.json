{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "description": "Requires the VCPKG_ROOT environment variable to point at a bootstrapped vcpkg checkout.",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "linux-clang-full-debug",
      "displayName": "Linux Clang Full Debug (engine + editor)",
      "description": "Requires the VCPKG_ROOT environment variable to point at a bootstrapped vcpkg checkout. Full engine+editor Debug build with Clang + Ninja using the vcpkg x64-linux triplet.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-clang-full-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "QUANTUM_ENABLE_ENGINE": "ON",
        "QUANTUM_ENABLE_EDITOR": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug (core)",
      "description": "Core-only Debug build with Clang + Ninja using distro glm/nlohmann_json.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "QUANTUM_ENABLE_ENGINE": "OFF",
        "QUANTUM_ENABLE_EDITOR": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug (core)",
      "description": "Core-only Debug build with GCC + Ninja using distro glm/nlohmann_json.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "QUANTUM_ENABLE_ENGINE": "OFF",
        "QUANTUM_ENABLE_EDITOR": "OFF",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "linux-clang-full-debug",
      "configurePreset": "linux-clang-full-debug"
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    }
  ],
  "testPresets": [
    {
      "name": "linux-clang-full-debug",
      "configurePreset": "linux-clang-full-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}